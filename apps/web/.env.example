# URL base del backend (sin /api al final; las rutas ya lo incluyen)
NEXT_PUBLIC_API_URL=http://localhost:4000

# PayPal JavaScript SDK (Sandbox; no incluir credenciales reales en el repositorio)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=tu_client_id_sandbox
# Moneda opcional: COP por defecto; usa USD si tu cuenta Sandbox no admite COP.
NEXT_PUBLIC_PAYPAL_CURRENCY=COP
