PORT=4000

# CORS (set to your frontend origin)
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=suplefit


# URL completa (opcional; si no se define, se construye desde DB_*)
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/suplefit

# Railway / PostgreSQL gestionado (opcional)
# DB_SSL=1

# MySQL (legacy — solo si usas repositorios MySql*)
# DB_PORT=3306

# Demo/admin seeding (optional)
SEED_DEMO=1
ADMIN_EMAIL=admin@suplefit.com
ADMIN_PASSWORD=Admin12345

