# Variables para el servicio API en Railway
# Copia/pega en Railway → Service (API) → Variables
# Tras crear el plugin MySQL, usa "Add Reference" o estos placeholders:

# --- MySQL (referencias al servicio MySQL del mismo proyecto) ---
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}

# --- App ---
PORT=
# Railway asigna PORT automáticamente; no lo fijes a 4000

JWT_SECRET=genera-un-secreto-largo-aleatorio
JWT_EXPIRES_IN=7d

# URL pública del frontend (Vercel, etc.)
CORS_ORIGIN=https://tu-app.vercel.app

# SSL recomendado en MySQL gestionado de Railway
DB_SSL=1

# Primera puesta en marcha: categorías, productos demo y admin
SEED_DEMO=1
ADMIN_EMAIL=admin@suplefit.com
ADMIN_PASSWORD=cambia-esta-contraseña
